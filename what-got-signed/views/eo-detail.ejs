<!DOCTYPE html>
<html lang="en" class="wa-cloak">
<head>
  <%- include('partials/head', { title: 'Executive Order — What Got Signed?' }) %>
</head>
<body>
  <div class="page">
    <div class="content eo-detail-content">
      <%- include('partials/header', { isHome: false }) %>

      <nav class="eo-breadcrumb">
        <a href="/" class="wa-link wa-caption-s">← Home</a>
        <span class="eo-badge wa-caption-s wa-color-text-quiet" id="eo-number-badge"></span>
      </nav>

      <div id="eo-error" style="display:none;" class="eo-error-state">
        <p class="wa-body-m wa-color-text-quiet" id="eo-error-message">Could not load this EO. Try refreshing.</p>
      </div>

      <div id="eo-main">
        <!-- Loading skeleton -->
        <div id="eo-skeleton" class="eo-skeleton" aria-label="Loading…">
          <div class="skeleton-line skeleton-h1"></div>
          <div class="skeleton-line skeleton-meta"></div>
          <div class="skeleton-line skeleton-body"></div>
          <div class="skeleton-line skeleton-body short"></div>
          <div class="skeleton-line skeleton-body"></div>
        </div>

        <!-- Content (hidden until loaded) -->
        <div id="eo-content" style="display:none;">
          <h1 class="eo-title wa-heading-l" id="eo-title"></h1>

          <p class="eo-meta wa-body-s wa-color-text-quiet">
            Signed <span id="eo-date"></span> by <span id="eo-president"></span>
          </p>

          <div class="eo-summary wa-body-m" id="eo-summary"></div>

          <div class="eo-themes" id="eo-themes"></div>

          <div class="eo-populations" id="eo-populations"></div>

          <hr class="eo-divider">
        </div>
      </div>

      <%- include('partials/back-to-top') %>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="/detail-eo.js"></script>
</body>
</html>
